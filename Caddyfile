# Site block for the shared Caddy on the finance VM.
# Do not start a second Caddy on ports 80 and 443.
# The finance container keeps those ports. See docs/deploy-oci.md.

iva.eduardomotta.dev {
	reverse_proxy iva-app:8000

	encode gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format json
	}
}
